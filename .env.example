# FastMedia Downloader - Variables de entorno (copiar a .env si se desea sobrescribir)

# Puertos publicados en el host (cambiar si estan ocupados por otras apps)
FRONTEND_PORT=3000
API_GATEWAY_PORT=8000

# URL pública del API Gateway que consume el navegador (bakeada en el build del frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Orígenes permitidos por CORS en el API Gateway
ALLOWED_ORIGINS=http://localhost:3000

# TTL (minutos) antes de purgar archivos temporales descargados
FILE_TTL_MINUTES=30
